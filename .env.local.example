# Supabase project URL
# Found at: Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon (publishable) key — safe to expose in client code
# Found at: Dashboard → Project Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Supabase service-role key — SERVER SIDE ONLY, never expose to client
# Found at: Dashboard → Project Settings → API → service_role secret key
# Used only in lib/supabase/admin.ts for org creation and invite acceptance
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
